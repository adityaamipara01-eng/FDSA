#include<iostream>
using namespace std;

void find(int car[],int target , int n, int count)
{
    for (int i = 0; i < n; i++)
    {
        if(target==car[i])
        {
            cout<<"Car found at "<<i+1<<endl;
            count++;
            continue;
        }
    }
}
int main()
{
    int n;
    cout<<"Enter the total number of cars in parking lot:"<<endl;
    cin>>n;
    int car[n];
    for (int i = 0; i < n; i++)
    {
        cin>>car[i];
    }
    
    int target;

    cout<<"Enter target plate number:"<<endl;
    cin>>target;
    int count = 0;

    find(car,target,n,count); 
}
